{
  "name": "dsh-ui-quota",
  "version": "2.1.0",
  "private": true,
  "description": "更好的用户菜单：左下角账户菜单（含用量抽屉、峰谷提示、面板入口收集）与设置页「用量」。必须搭配 dsh-ui-suite 使用。",
  "icon": "./icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alamanes/applesdsh-dev.git",
    "directory": "plugins/dsh-ui-quota"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ui-suite",
    "quota",
    "user-menu"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": {
      "default": "./locale/*.json"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.png",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "license": "MIT"
}
