{
  "name": "dsh-commandcode-quota",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "commandcode",
    "command-code",
    "quota",
    "usage",
    "credits",
    "composer",
    "llm"
  ],
  "description": "Command Code plan quota for DeepSeek Harness: three ring gauges for the 5-hour / weekly / monthly credit windows beside the model picker in the input row, plus per-model request allowances in the settings panel.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./catalog": "./catalog.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "quota.mjs",
    "catalog.mjs",
    "catalog.seed.json",
    "cli",
    "preview",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Jovan1666/commandcode-usage",
  "repository": "https://github.com/Jovan1666/commandcode-usage",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
