{
  "name": "dsh-web-search-tavily",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tavily",
    "web-search",
    "search",
    "web"
  ],
  "description": "Tavily-backed search provider for the DeepSeek Harness web seam: registers a second, independent `tavily` backend beside the shipped DeepSeek one, so web_search runs on Tavily's own REST API.",
