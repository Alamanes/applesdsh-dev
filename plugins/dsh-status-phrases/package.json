{
    "name": "dsh-status-phrases",
    "version": "0.1.0",
    "description": "Replace the DSH turn-status line (\"Deep diving…\" / \"深度求索中…\") with rotating phrases typed out one character at a time under a rainbow gradient, configured through a single multi-line box in Settings → General.",
    "type": "module",
    "main": "./lib/index.js",
    "exports": {
        ".": {
            "default": "./lib/index.js"
        },
        "./client": {
            "default": "./lib/client.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib/index.js",
        "lib/client.js",
        "cordis.patch.yml",
        "README.md"
    ],
    "keywords": [
        "dsh",
        "deepseek-harness",
        "dsh-plugin",
        "plugin",
        "status",
        "typewriter",
        "rainbow",
        "phrases"
    ],
    "license": "MIT",
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "immediately": true
        }
    }
}
