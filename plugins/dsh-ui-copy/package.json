{
  "name": "dsh-ui-copy",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek Harness 界面改写插件：空态大标题轮换、输入框空置提示改写、预览版徽章隐藏、输入卡片的 Codex 视觉、ask_user 提问弹窗的 OpenAI 视觉、菜单开合动画，以及侧栏新会话按钮降噪。不动官方包，只经 DOM 与样式表。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "copy",
    "i18n",
    "hero",
    "composer",
    "motion",
    "menu",
    "sidebar",
    "rebrand",
    "openai",
    "ask-user-question"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./ask": {
      "default": "./lib/ask.js"
    },
    "./ask/locale/*.json": {
      "default": "./locale/ask/*.json"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./composer": {
      "default": "./lib/composer.js"
    },
    "./menu": {
      "default": "./lib/menu.js"
    },
    "./sidebar": {
      "default": "./lib/sidebar.js"
    },
    "./locale/*.json": {
      "default": "./locale/*.json"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
