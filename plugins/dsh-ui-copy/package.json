{
  "name": "dsh-ui-copy",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek Harness 界面文案改写插件：空态大标题轮换、输入框空置提示改写、预览版徽章隐藏。不动官方包，只经 DOM 与一张样式表。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "copy",
    "i18n",
    "hero",
    "composer",
    "rebrand"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
