{
  "name": "dsh-local-identity",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness 侧栏左下角账号芯片的本地身份插件：用本机配置的名字与头像替换 DeepSeek 账号的姓名与头像，菜单本身仍由官方账号组件提供。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "identity",
    "avatar",
    "sidebar",
    "account",
    "rebrand"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
