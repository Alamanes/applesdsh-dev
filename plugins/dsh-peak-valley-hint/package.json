{
  "name": "dsh-peak-valley-hint",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek Harness 侧栏底部的峰谷时段提示：在侧栏底栏右侧显示当前处于高峰还是低谷时段，以及距下一次切换的倒计时。规则与出错提示都写在浏览器半边，不依赖其它插件。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "peak",
    "off-peak",
    "valley",
    "pricing"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT"
}
